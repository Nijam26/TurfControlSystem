@page
@model TurfControlSystem.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in — Turf Operating &amp; Live Control System</title>
    <base href="~/" />
    <link rel="stylesheet" href="css/app.css" />
</head>
<body>
    <div class="login-wrap">
        <div class="login-shell">

            <!-- Left: brand / hero panel -->
            <div class="login-hero">
                <div class="login-hero-glow"></div>
                <div class="login-hero-content">
                    <div class="nav-brand login-hero-brand">⚽ TURF ARENA</div>
                    <h1 class="login-hero-title">Run the pitch<br />from one screen.</h1>
                    <p class="login-hero-sub">
                        Live bookings, countdown timers, and daily reports for every turf —
                        all in real time.
                    </p>

                    <ul class="login-hero-points">
                        <li><span class="login-hero-dot"></span> Live turf status &amp; countdowns</li>
                        <li><span class="login-hero-dot"></span> Bookings, teams &amp; payments</li>
                        <li><span class="login-hero-dot"></span> Daily &amp; weekly PDF reports</li>
                    </ul>
                </div>
            </div>

            <!-- Right: sign-in form -->
            <div class="login-form-side">
                <form class="login-card" method="post">
                    <div class="login-card-header">
                        <h2>Welcome back</h2>
                        <p class="subtitle" style="margin-bottom:0;">Sign in to continue to your dashboard</p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <p class="message message-error">@Model.ErrorMessage</p>
                    }

                    <label>Username
                        <input type="text" name="Username" value="@Model.Username" autofocus required placeholder="Enter your username" />
                    </label>
                    <label>Password
                        <input type="password" name="Password" required placeholder="Enter your password" />
                    </label>

                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />

                    <button class="btn btn-primary login-submit" type="submit">Sign in</button>

                    <p class="login-footnote">Ask an admin if you need access to a turf or role.</p>
                </form>
            </div>

        </div>
    </div>
</body>
</html>
