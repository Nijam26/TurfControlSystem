@page "/dashboard"
@implements IAsyncDisposable
@inject BookingService BookingSvc
@inject TurfTimerService TimerSvc
@inject IJSRuntime JS

<PageTitle>Operator Dashboard</PageTitle>

<PagePermissionGuard PageKey="Dashboard">

<h1>🎛️ Turf Control Dashboard</h1>
<p class="subtitle">Live view of every turf. Updates automatically every second — no refresh needed.</p>

@if (_statuses is null)
{
    <p>Loading…</p>
}
else
{
    <div class="turf-grid">
        @foreach (var status in _statuses)
        {
            <div class="turf-card status-@status.LightStatus.ToString().ToLowerInvariant()">
                <div class="turf-card-header">@status.TurfName</div>

                @if (status.HasActiveBooking)
                {
                    <div class="team-name">@status.TeamName</div>
                    <div class="countdown">@FormatTime(status.RemainingSeconds)</div>
                    <div class="status-label">@(status.IsPaused ? "PAUSED" : LabelFor(status.LightStatus))</div>

                    <div class="turf-actions">
                        <button class="btn btn-pause" @onclick="() => TogglePause(status.BookingId!.Value)">
                            @(status.IsPaused ? "▶ Resume" : "⏸ Pause")
                        </button>
                        <button class="btn btn-extend" @onclick="() => Extend(status.BookingId!.Value, 10)">➕ +10 min</button>
                        <button class="btn btn-stop" @onclick="() => Stop(status.BookingId!.Value)">⏹ Stop</button>
                    </div>
                }
                else
                {
                    <div class="idle-label">— IDLE —</div>
                }

                @if (status.NextTeamName is not null)
                {
                    <div class="next-booking">
                        Next: <strong>@status.NextTeamName</strong> @status.NextStartTime?.ToString("hh:mm tt")
                    </div>
                }
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(_lastMessage))
{
    <div class="toast">@_lastMessage</div>
}

</PagePermissionGuard>

@code {
    private List<TurfStatusDto>? _statuses;
    private string? _lastMessage;
    private DotNetObjectReference<Dashboard>? _dotNetRef;
    private static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    protected override async Task OnInitializedAsync()
    {
        _statuses = await TimerSvc.GetTurfStatusesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("turfTimer.start", _dotNetRef);
        }
    }

    [JSInvokable]
    public void OnStatusesReceived(string json)
    {
        _statuses = JsonSerializer.Deserialize<List<TurfStatusDto>>(json, JsonOpts);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnAnnouncementReceived(string json)
    {
        var announcement = JsonSerializer.Deserialize<AnnouncementDto>(json, JsonOpts);
        _lastMessage = announcement?.Message;
        StateHasChanged();
    }

    private async Task TogglePause(int bookingId)
    {
        var (_, message) = await BookingSvc.TogglePauseAsync(bookingId);
        _lastMessage = message;
    }

    private async Task Extend(int bookingId, int minutes)
    {
        var (_, message) = await BookingSvc.ExtendBookingAsync(bookingId, minutes);
        _lastMessage = message;
    }

    private async Task Stop(int bookingId)
    {
        var (_, message) = await BookingSvc.StopBookingAsync(bookingId);
        _lastMessage = message;
    }

    private static string FormatTime(int totalSeconds)
    {
        var t = TimeSpan.FromSeconds(Math.Max(0, totalSeconds));
        return $"{(int)t.TotalMinutes:D2}:{t.Seconds:D2}";
    }

    private static string LabelFor(TurfLightStatus status) => status switch
    {
        TurfLightStatus.Running => "RUNNING",
        TurfLightStatus.EndingSoon => "ENDING SOON",
        TurfLightStatus.AlmostUp => "TIME ALMOST UP",
        TurfLightStatus.TimeUp => "TIME UP",
        _ => "IDLE"
    };

    public async ValueTask DisposeAsync()
    {
        if (_dotNetRef is not null)
        {
            try { await JS.InvokeVoidAsync("turfTimer.stop"); }
            catch (JSDisconnectedException) { /* circuit already gone — nothing to clean up client-side */ }
            _dotNetRef.Dispose();
        }
    }
}
